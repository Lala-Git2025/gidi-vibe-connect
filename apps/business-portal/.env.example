VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_APP_NAME=Gidi Business Portal
VITE_CONSUMER_APP_URL=http://localhost:8080

# Error reporting (optional). Leave empty to disable Sentry entirely.
# On Vercel set this on the project; VITE_APP_RELEASE / VITE_APP_ENV are
# derived at build time and need no configuration. To also upload source maps,
# set SENTRY_AUTH_TOKEN, SENTRY_ORG and SENTRY_PROJECT on the Vercel project.
VITE_SENTRY_DSN=
